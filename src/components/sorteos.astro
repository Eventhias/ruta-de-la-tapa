---
import { Icon } from "astro-icon/components";
import ContentSection from "./content-section.astro";
import type { FeatureItem } from "../types";

const features: Array<FeatureItem> = [
  {
    title: "Premios",
    description: "Al finalizar el evento de la ruta, las 3 tapas con mayor puntuación ganarán la Cebolla de Oro, de Plata y de Bronce.",
    icon: "mdi:medal",
  },
  {
    title: "Sorteos",
    description:
      "Se sortearán 3 cenas para 2 personas en los establecimientos ganadores de nuestra II Edición de la Ruta de la Tapa de la cebolla de Guayonje.",
    icon: "mdi:clover",
  }
];
---

<ContentSection title="Premios y Sorteos" id="sorteos">
  <Fragment slot="lead">
    La Ruta contará con una serie de <span class="text-primary">premios y sorteos</span> para los establecimientos y participantes que voten en la App.
  </Fragment>
  <ul class="grid max-w-6xl grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-2">
    {
      features.map(({ title, description, icon }) => (
        <li class="flex flex-col items-center gap-4 border border-default bg-offset p-6 h-full" style="border-radius: 10px">
          <div class="size-16 rounded-full border-2 border-current p-3">
            <Icon name={icon} class="size-full" />
          </div>
          <p class="text-center font-extrabold text-xl">{title}</p>
          <p class="text-center text-offset text-sm">{description}</p>
        </li>
      ))
    }
  </ul>
</ContentSection>
