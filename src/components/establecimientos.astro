---
import { Icon } from "astro-icon/components";
import ContentSection from "~/components/content-section.astro";
import type { FeatureItem } from "~/types";

const features: Array<FeatureItem> = [
  {
    title: "Deliciosas",
    description: "Todas las Tapas tendrán el sabor único de nuestra Cebolla de Guayonje.",
    icon: "mdi:pasta",
  },
  {
    title: "Bebida incluida",
    description:
      "Podras disfrutar de un vino de Tacoronte, una caña, un refresco o agua.",
    icon: "mdi:beer",
  },
  {
    title: "Asequible",
    description:
      "¡Por tan solo 4,00€! Para que puedas probarlas todas.",
    icon: "mdi:currency-eur",
  }
];
---

<ContentSection title="La Tapa" id="establecimientos">
  <Fragment slot="lead">
    Explora los diversos establecimientos de la 
    <span class="text-primary">Ruta de la Tapa</span> 
    y disfruta de las
    <span class="text-primary">deliciosas tapas</span> locales.
  </Fragment>
  <ul class="grid max-w-6xl grid-cols-1 md:grid-cols-1 lg:grid-cols-3">
    {
      features.map(({ title, description, icon }) => (
        <a href="http://localhost:4200/app" class="m-1">
          <li class="flex flex-col items-center gap-4 border border-default bg-offset p-6 h-full" style="border-radius: 10px">
            <div class="size-16 rounded-full border-2 border-current p-3">
              <Icon name={icon} class="size-full" />
            </div>
            <p class="text-center font-extrabold text-xl">{title}</p>
            <p class="text-center text-offset text-sm">{description}</p>
          </li>
        </a>
      ))
    }
  </ul>
</ContentSection>
