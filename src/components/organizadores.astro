---
import ContentSection from "~/components/content-section.astro";
import { Image } from "astro:assets";
import quimpi from "~/assets/quimpi.png";
import cabildo from "~/assets/cabildo.png";
import logo from "~/assets/eventhias-logo.png";
import comercio from "~/assets/comercio.png";

const organizadores = [
  {
    title: "Eventhias",
    imagen: logo,
    url: "https://www.eventhias.com/",
    size: 120
  }
];

const partners = [
  {
    title: "Cabildo Tenerife",
    imagen: cabildo,
    url: "https://www.tenerife.es/portalcabtfe/es/",
    size: 150,
  },
  {
    title: "Comercio de Tenerife",
    imagen: comercio,
    url: "https://www.tenerifecomercio.com/",
    size: 140
  },
  {
    title: "Quimpi",
    imagen: quimpi,
    url: "https://www.quimpi.com/",
    size: 130
  }
];

---

<ContentSection title="Organiza" id="organizadores">
  <Fragment slot="lead">
    AYUNTAMIENTO <br> O CONCEJALÍA CORRESPONDIENTE
    <ul class="grid max-w-6xl grid-cols-1 md:grid-cols-2 gap-2" style="margin-top: 0">
      {
        organizadores.map((item) => (
          <li class="flex flex-col items-center gap-4 p-6 h-full">
            <a class="flex flex-col items-center gap-2" href={item.url}>
              <Image 
                class="text-white"
                src={item.imagen}
                width={item.size}
                loading="eager"
                alt={item.title}
                />
            </a>
          </li>
        ))
      }
    </ul>
  </Fragment>
  
    <span class="text-primary font-bold" style="font-size: 30px">Colabora</span>
    <ul class="grid max-w-6xl grid-cols-1 md:grid-cols-2 gap-2" style="margin-top: 0">
      {
        partners.map((item) => (
          <li class="flex flex-col items-center gap-4 p-6 h-full">
            <a class="flex flex-col items-center gap-2" href={item.url}>
              <Image 
                class="text-white"
                src={item.imagen}
                width={item.size}
                loading="eager"
                alt={item.title}
                />
            </a>
          </li>
        ))
      }
    </ul>
</ContentSection>
