---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import HeroImage from "~/components/hero-image.astro";
import type { FooterLink } from "~/types";
import logoEventhias from "../assets/eventhias-white-logo.png";

const links: Array<FooterLink> = [
  {
    url: "https://www.eventhias.com/",
    description: "Web oficial Eventhias",
    icon: "mdi:web",
  },
  {
    url: "https://www.instagram.com/codecanario.sl/",
    description: "Perfil oficial de Codecanario",
    icon: "mdi:instagram",
  },
  {
    url: "https://www.facebook.com/eventhias",
    description: "Perfil oficial de Eventhias",
    icon: "mdi:facebook",
  }
];
---

<footer class="relative flex h-64 items-center justify-center" style="flex-direction: column;">
  <div class="absolute inset-0 overflow-hidden opacity-40">
    <HeroImage />
  </div>
  <ul class="relative grid grid-cols-3 gap-4 sm:grid-cols-3">
    {
      links.map((link) => (
        <li>
          <a
            class="flex size-16 items-center justify-center rounded-full border-2 border-current p-4"
            href={link.url} target="_blank"
          >
            <span class="sr-only">{link.description}</span>
            <Icon class="size-full" name={link.icon} />
          </a>
        </li>
      ))
    }
  </ul>
  <a style="z-index: 9; margin-top: 15px" href="https://www.eventhias.com">
    <Image 
        class="text-white"
        src={logoEventhias}
        width=200
        loading="eager"
        alt="Logo Eventhias"
        />
  </a>
</footer>
