---
import ContentSection from "~/components/content-section.astro";
import { Image } from "astro:assets";
import quimpi from "~/assets/quimpi.png";
import cabildo from "~/assets/cabildo.png";
import tacoronte from "~/assets/tacoronte.png";

const colaboradores = [
  {
    title: "Ayto. Tacoronte",
    imagen: tacoronte,
    url: "https://www.tacoronte.es/",
    size: 90
  },
  {
    title: "Quimpi",
    imagen: quimpi,
    url: "https://www.quimpi.com/",
    size: 150
  },
  {
    title: "Cabildo Tenerife",
    imagen: cabildo,
    url: "https://www.tenerife.es/portalcabtfe/es/",
    size: 100
  }
];

---

<ContentSection title="Colaboradores" id="colaboradores">
  <Fragment slot="lead">
    Unidos por la <span class="text-primary">excelencia</span>,
    nuestros valiosos <span class="text-primary">colaboradores</span> lo hacen posible.
  </Fragment>
  <div class="max-w-6xl space-y-2">
    <div class="relative border border-default bg-offset px-6 pb-4 pt-8">
      <ul class="grid grid-cols-1 gap-8 sm:grid-cols-3 md:grid-cols-3">
        {
          colaboradores.map((item) => (
            <li>
              <a class="flex flex-col items-center gap-2" href={item.url}>
                <Image 
                  class="text-white"
                  src={item.imagen}
                  width={item.size}
                  loading="eager"
                  alt="Logo Ayuntamiento de Tacoronte"
                  />
                <span></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</ContentSection>
