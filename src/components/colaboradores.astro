---
import CompatibilityList from "~/components/compatibility-list.astro";
import ContentSection from "~/components/content-section.astro";
import type { CompatibilityItem } from "~/types";

const frameworks: Array<CompatibilityItem> = [
  {
    title: "Quimpi",
    icon: "frameworks/react",
    url: "https://reactjs.org/",
  },
  {
    title: "Ayto. Tacoronte",
    icon: "frameworks/preact",
    url: "https://preactjs.com/",
  },
  {
    title: "Cabildo Insular",
    icon: "frameworks/svelte",
    url: "https://svelte.dev/",
  }
];

---

<ContentSection title="Colaboradores" id="colaboradores">
  <Fragment slot="lead">
    Unidos por la <span class="text-primary">excelencia</span>,
    nuestros valiosos <span class="text-primary">colaboradores</span> lo hacen posible.
  </Fragment>
  <CompatibilityList
    items={frameworks}
    title="Frameworks"
    url="https://docs.astro.build/core-concepts/framework-components/"
  />
</ContentSection>
