---
import { Image } from "astro:assets";
import cebolla from "~/assets/cebollaGuayonje.png";
import logoAyto from "~/assets/logoAyto.png";
import HeroImage from "~/components/hero-image.astro";
import { Icon } from "astro-icon/components";

const widths = [450, 800];
const sizes = "(min-width: 640px) 42vw, 67vw";
const logoSize = 80
---

<section class="relative h-full tacoronte-bg">
  <div id="splash-bg-fallback" class="absolute inset-0 hidden opacity-40">
    <HeroImage />
  </div>
  <div class="relative grid h-full place-items-center sm:grid-cols-2 ml-6">
    <h2
      class="flex flex-col items-center gap-2 self-end sm:gap-4 sm:self-auto sm:justify-self-end"
    >
      <Image 
        class="text-white"
        src={logoAyto}
        width={logoSize}
        loading="eager"
        alt="Logo Ayuntamiento de Tacoronte"
        />
      <div
        class="text-white text-center font-extrabold tracking-tighter text-4xl"
      >
        1ª Edición
        <br /> Ruta de la Tapa
        <br /> Cebolla de Guayonje
      </div>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
        <a
          href="#"
          class="text-white flex items-center justify-center gap-3 border-2 border-current px-6 py-4"
          style="border-radius: 10px"
        >
          <Icon name="mdi:login" class="size-8" />
          <span>Login</span>
        </a>
        <a
          href="#"
          class="text-white flex items-center justify-center gap-3 border-2 border-current px-6 py-4"
          style="border-radius: 10px"
        >
          <Icon name="mdi:star" class="size-8" />
          <span>Votar Tapa</span>
        </a>
      </div>
    </h2>
    <div
      id="astronaut"
      class="w-2/3 max-w-3xl self-start sm:w-10/12 sm:self-auto sm:justify-self-start"
    >
      <Image
        class="h-full w-full object-cover"
        src={cebolla}
        widths={widths}
        sizes={sizes}
        loading="eager"
        alt="Cebolla de Guayonje flotando"
      />
    </div>
  </div>
</section>

<noscript>
  <style>
    #splash-bg-fallback {
      display: block;
    }
  </style>
</noscript>

<style>
  @keyframes float {
    0% {
      transform: translate3d(0, 0, 0);
    }

    100% {
      transform: translate3d(0, 30px, 0);
    }
  }

  /* #astronaut {
    animation: float linear 2.5s infinite alternate;
  } */

  @media (prefers-reduced-motion: reduce) {
    #astronaut {
      @apply animate-none;
    }

    :global(#starfield) {
      @apply hidden;
    }

    #splash-bg-fallback {
      @apply block;
    }
  }
  .tacoronte-bg {
    background-image: 
      linear-gradient(var(--color-background-title-6), var(--color-background-title-9)),
      url('../assets/tacoronte_bg.jpg');
    background-size: cover;
    background-position: left;
  }
</style>
